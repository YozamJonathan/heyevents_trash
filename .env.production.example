# HeyEvent — production environment.
#
# deploy.sh copies this file to `.env.production` and fills in APP_KEY,
# DB_PASSWORD, DB_ROOT_PASSWORD and APP_URL. Anything left as an empty value
# after that is a bug — deploy.sh refuses to start without them.
#
# `.env.production` is gitignored. Never commit the real thing.

APP_NAME=HeyEvent
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# No trailing slash.
APP_URL=

# Compose binds this host port to nginx in the container. Change to 8080 to run
# something else on port 80 on the host.
APP_PORT=80

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ----------------------------------------------------------------
# `daily` rotates laravel.log into dated files. Combined with the volume in
# docker-compose.yml this survives restarts instead of vanishing.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=7

# --- Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=heyevent
DB_USERNAME=heyevent
DB_PASSWORD=
# Only ever used by the mysql container itself. Set a different value.
DB_ROOT_PASSWORD=

# --- Session / cache / queue ------------------------------------------------
# All three point at MySQL, which is why the users/cache/jobs migrations must
# have run. The `queue` service in docker-compose.yml is what drains the queue.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave false while the site is plain HTTP. Set true the moment HTTPS is on, or
# the browser will refuse to send the cookie and logins will silently fail.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
CACHE_PREFIX=

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1

# --- Mail -------------------------------------------------------------------
# `log` means messages are written to the log and never actually sent. That is
# fine for a demo but password resets will not reach anyone. See DEPLOY.md for
# the SES SMTP switch.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- S3 (optional) ----------------------------------------------------------
# Only needed if uploads should outlive the instance. Unused while
# FILESYSTEM_DISK=local and the storage volume is doing the job.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
